# 第一次启动的引导会帮你生成 .env，一般不用手动改；想手动配置就复制一份改名为 .env
# 默认全部用千问 (阿里云百炼)，一个 Key 管脑子、眼睛、嘴巴

# ===== 脑子：聊天、思考、调用工具 =====
VOLC_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
VOLC_API_KEY=你的百炼 Key
VOLC_MODEL_NAME="qwen-plus"
# 其他 OpenAI 兼容接口也行，例如 DeepSeek：
#   VOLC_BASE_URL="https://api.deepseek.com"  VOLC_MODEL_NAME="deepseek-chat"

# ===== 眼睛：看屏幕 =====
VOLC_VISION_MODEL_NAME="qwen-vl-max"
# 想单独接另一家 (比如脑子用 DeepSeek、眼睛用 GPT) 就填下面两项，不填就和脑子共用
# VISION_BASE_URL="https://api.openai.com/v1"
# VISION_API_KEY=

# ===== 声音 (千问 Omni)：实时对话和平时说话都是这一个音色 =====
OMNI_MODEL=qwen3.8-omni-flash-realtime
# 要选实时和非实时模型都有的音色才能统一：Tina 甜甜 (甜美温暖)  Momo 茉兔 (俏皮逗趣)  Roya 萝雅 (阳光洒脱)
OMNI_VOICE=Tina
# 平时 (打字聊天、早报、提醒等) 负责朗读的模型
OMNI_SPEAK_MODEL=qwen3.5-omni-flash
# 实时对话连不上时换成带工作空间 ID 的地址：wss://你的工作空间ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# OMNI_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 她说完后等你接话的时间 (秒)，默认 12；觉得结束太快就调大，想更快回待机就调小
# OMNI_IDLE_SECONDS=12

# ===== QQ 机器人 (预留，默认关闭)：不在电脑前也能用手机 QQ 找她聊天 =====
# 要用时把下面这行打开；不打开就不启动，即使填了 AppID/Secret
# QQ_BOT_ENABLED=true
# 在 QQ 开放平台 (q.qq.com) 创建机器人后填这两项
# QQ_BOT_APPID=
# QQ_BOT_SECRET=
# 白名单：身份码:名字，多个用逗号隔开。身份码第一次用 QQ 给她发消息时她会告诉你
# QQ_ALLOWED_USERS=身份码:小明
# 开着 Clash 等代理时默认先直连 QQ 的服务器，不通再走代理；也可以固定成 direct / system
# QQ_BOT_PROXY=auto
# QQ 上的语音：auto=你发语音她就回语音、你打字她就回文字 (默认)；voice=总是回语音；text=只回文字
# QQ_VOICE_REPLY=auto
# QQ 语音用哪个引擎生成：tts=朗读合成 (默认，快、便宜)；realtime=实时模型 (更像电脑前，能唱)
# QQ_VOICE_ENGINE=tts
# 语音识别：auto=先用 QQ 自带的识别结果、没有再用本地 Whisper；qq=只信 QQ 的 (不加载本地模型)；whisper=总是用本地模型
# QQ_VOICE_STT=auto
# 一条语音最多念多少字，超出的部分用文字消息补发 (默认 120 字，约 50 秒)
# QQ_VOICE_MAX_CHARS=120
